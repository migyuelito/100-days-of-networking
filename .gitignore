.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.swp
~$*

# Private working files: never published
private/
**/raw/
*.unsanitized.*

# Packet captures can contain addresses, names, and credentials
*.pcap
*.pcapng

# Note: .gitignore only stops new files from being added.
# It does not remove files that are already committed.
